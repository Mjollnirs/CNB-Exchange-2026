meta {
  name: release-match
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/claims/1/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "status": "under-review" }
}

tests {
  test("A6.7: Releasing a matched claim (PATCH → under-review) clears matched_item and returns the item to in-storage (claim released, link cleared)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("under-review");
    expect(res.body.data.matched_item).to.equal(null);
  });
}
