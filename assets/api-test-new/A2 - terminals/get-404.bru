meta {
  name: get-404
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/terminals/999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A2.4: GET /terminals/{id} returns the terminal with counts; 404 for unknown id (404)", function() {
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("Resource not found");
  });
}
