meta {
  name: passwords-hashed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/claims/track/HASH-CHECK
  body: none
  auth: none
}

script:pre-request {
  const mysql = require("mysql2/promise");

  try {
    const conn = await mysql.createConnection({
      host: bru.getEnvVar("dbHost") || "127.0.0.1",
      port: Number(bru.getEnvVar("dbPort") || 3306),
      user: bru.getEnvVar("dbUser"),
      password: bru.getEnvVar("dbPass") || "",
      database: bru.getEnvVar("dbName"),
      charset: "utf8mb4",
    });
    try {
      const [rows] = await conn.execute(
        "SELECT password FROM passengers WHERE email = ?",
        [bru.getEnvVar("regEmail")]
      );
      bru.setVar("storedPassword", rows.length ? String(rows[0].password) : "NO ROW FOUND");
    } finally {
      await conn.end();
    }
  } catch (e) {
    bru.setVar("storedPassword", "QUERY FAILED: " + e.message.split("\n")[0]);
  }
}

tests {
  test("A1.7: Passwords are stored hashed in the database", function() {
    const stored = bru.getVar("storedPassword");
    expect(stored, "could not read the registered passenger's stored password").to.be.a("string").with.length.greaterThan(0);
    expect(stored).to.not.include("QUERY FAILED");
    expect(stored).to.not.equal("NO ROW FOUND");
    expect(stored, "password stored as plaintext").to.not.equal("mypassword1");
    expect(stored.length, "stored value too short to be a hash").to.be.at.least(32);
  });
}
