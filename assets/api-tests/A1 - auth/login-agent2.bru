meta {
  name: login-agent2
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "agent2@reclaim-pvg.cn", "password": "agent123" }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("agent2Token", res.body.data.token);
  }
}

tests {
  test("A1.1: POST /login returns 200 with token and user object (id, name, email, role) (second agent)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.role).to.equal("agent");
  });
}
