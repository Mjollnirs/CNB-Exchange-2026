meta {
  name: login-admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "admin1@reclaim-pvg.cn", "password": "admin123" }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("adminToken", res.body.data.token);
  }
}

tests {
  test("A1.1: POST /login returns 200 with token and user object (id, name, email, role)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.token).to.be.a("string");
    expect(res.body.data.token.length).to.be.greaterThan(20);
    expect(res.body.data.user).to.have.property("id");
    expect(res.body.data.user).to.have.property("name");
    expect(res.body.data.user.email).to.equal("admin1@reclaim-pvg.cn");
    expect(res.body.data.user.role).to.equal("admin");
  });
}
