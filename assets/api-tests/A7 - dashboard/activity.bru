meta {
  name: activity
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/dashboard/activity
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A7.5: GET /dashboard/activity returns the 20 most recent staff entries, newest first — passenger actions (no user) excluded", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.lengthOf(20);
    res.body.data.forEach(entry => {
      expect(entry.user).to.not.equal(null);
      expect(entry).to.have.property("action");
      expect(entry).to.have.property("details");
    });
    const dates = res.body.data.map(e => new Date(e.created_at).getTime());
    for (let i = 1; i < dates.length; i++) {
      expect(dates[i - 1]).to.be.at.least(dates[i]);
    }
  });
}
