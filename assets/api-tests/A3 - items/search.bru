meta {
  name: search
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/items?search=passport
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A3.3: ?search matches brand or description", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.be.greaterThan(0);
    res.body.data.forEach(item => {
      const haystack = ((item.brand || "") + " " + item.description).toLowerCase();
      expect(haystack).to.include("passport");
    });
  });
}
