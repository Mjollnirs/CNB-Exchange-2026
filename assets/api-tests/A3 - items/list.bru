meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A3.1: GET /items returns paginated list with nested terminal and registered_by objects, newest first", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array").with.lengthOf(15);
    expect(res.body.meta.per_page).to.equal(15);
    expect(res.body.meta.total).to.equal(123);
    const item = res.body.data[0];
    expect(item.reference_code).to.match(/^FI-[A-Z0-9]{8}$/);
    expect(item.terminal).to.have.all.keys("id", "name", "code");
    expect(item).to.have.property("category");
    expect(item).to.have.property("found_on");
    expect(item).to.have.property("found_location");
    expect(item).to.have.property("storage_shelf");
    expect(item).to.have.property("status");
  });
}
