meta {
  name: passwords-hashed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/claims/track/HASH-CHECK
  body: none
  auth: none
}

script:pre-request {
  const { execFileSync } = require("child_process");

  const mysqlBin = bru.getEnvVar("mysqlPath") || "mysql";
  const pass = bru.getEnvVar("dbPass") || "";
  const args = [
    "-h", bru.getEnvVar("dbHost") || "127.0.0.1",
    "-P", String(bru.getEnvVar("dbPort") || 3306),
    "-u", bru.getEnvVar("dbUser"),
  ];
  if (pass !== "") args.push(`-p${pass}`);
  const db = bru.getEnvVar("dbName");
  const email = bru.getEnvVar("regEmail");

  try {
    const stored = execFileSync(mysqlBin, [...args, "-N", "-e",
      `SELECT password FROM ${db}.passengers WHERE email = '${email}'`])
      .toString().trim();
    bru.setVar("storedPassword", stored);
  } catch (e) {
    bru.setVar("storedPassword", "QUERY FAILED: " + e.message.split("\n")[0]);
  }
}

tests {
  test("A1.7: Passwords are stored hashed in the database", function() {
    const stored = bru.getVar("storedPassword");
    expect(stored, "could not read the registered passenger's stored password").to.be.a("string").with.length.greaterThan(0);
    expect(stored).to.not.include("QUERY FAILED");
    expect(stored, "password stored as plaintext").to.not.equal("mypassword1");
    expect(stored.length, "stored value too short to be a hash").to.be.at.least(32);
  });
}
