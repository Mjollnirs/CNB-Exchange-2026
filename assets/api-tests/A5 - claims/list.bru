meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/claims
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A5.1: GET /claims returns paginated list with nested passenger, terminal and matched_item, newest first", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.per_page).to.equal(15);
    expect(res.body.meta.total).to.equal(61);
    const claim = res.body.data[0];
    expect(claim.reference_code).to.match(/^CL-[A-Z0-9]{8}$/);
    expect(claim.passenger).to.have.all.keys("id", "first_name", "last_name", "email");
    expect(claim.terminal).to.have.all.keys("id", "name", "code");
    expect(claim).to.have.property("matched_item");
  });
}
