meta {
  name: filter-status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/claims?status=submitted
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A5.2: ?status, ?category and ?terminal_id filters return the correct subsets (status)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(10);
    res.body.data.forEach(claim => expect(claim.status).to.equal("submitted"));
  });
}
