meta {
  name: scoping-list
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/claims
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agentToken}}
}

tests {
  test("A5.7: Agents are scoped to their assigned terminals for claim list and detail (403 cross-terminal) (list scoped)", function() {
    expect(res.status).to.equal(200);
    res.body.data.forEach(claim => {
      expect([1, 3]).to.include(claim.terminal.id);
    });
  });
}
