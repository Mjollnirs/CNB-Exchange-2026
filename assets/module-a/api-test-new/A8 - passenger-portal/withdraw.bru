meta {
  name: withdraw
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/passenger/claims/{{newClaimId}}/withdraw
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A8.7: POST /passenger/claims/{id}/withdraw: own open claim → withdrawn (200); non-open claims 422 (withdrawn)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("withdrawn");
  });
}
