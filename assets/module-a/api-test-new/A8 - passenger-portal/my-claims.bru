meta {
  name: my-claims
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/passenger/claims
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A8.4: GET /passenger/claims returns only the passenger's own claims, paginated, without the passenger object; ?status filter (own claims)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(19);
    expect(res.body.meta.per_page).to.equal(15);
    expect(res.body.data).to.have.lengthOf(15);
    res.body.data.forEach(claim => {
      expect(claim).to.not.have.property("passenger");
      expect(claim).to.have.property("terminal");
    });
  });
}
