meta {
  name: my-terminals-agent
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/my-terminals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agentToken}}
}

tests {
  test("A7.6: GET /my-terminals returns the agent's terminals with todays_items and open_claims; 403 for admins (agent view)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.lengthOf(2);
    const codes = res.body.data.map(row => row.terminal.code).sort();
    expect(codes).to.eql(["PVG-S1", "PVG-T1"]);
    res.body.data.forEach(row => {
      expect(row.todays_items).to.be.an("array");
      expect(row.open_claims).to.be.an("array");
    });
  });
}
