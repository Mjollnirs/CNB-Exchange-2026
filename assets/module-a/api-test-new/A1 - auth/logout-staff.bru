meta {
  name: logout-staff
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A1.4: POST /logout invalidates the token and returns 200 — subsequent requests with the old token get 401 (logout)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Logged out successfully");
  });
}
