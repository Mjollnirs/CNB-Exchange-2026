  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "status": "under-review" }
}

tests {
  test("A5.5: PATCH /claims/{id}/status rejects statuses owned by dedicated endpoints and invalid transitions (422) (invalid transition)", function() {
    expect(res.status).to.equal(422);
  });
}
