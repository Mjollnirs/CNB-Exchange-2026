meta {
  name: scoping-403
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/claims/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agent2Token}}
}

tests {
  test("A5.7: Agents are scoped to their assigned terminals for claim list and detail (403 cross-terminal) (detail 403)", function() {
    expect(res.status).to.equal(403);
    expect(res.body.message).to.equal("Forbidden");
  });
}
