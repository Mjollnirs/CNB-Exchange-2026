meta {
  name: resolve
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/claims/2/resolve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A6.8: POST /claims/{id}/resolve: matched claim → resolved with resolved_at auto-set; item → returned (claim resolved)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("resolved");
    expect(res.body.data.resolved_at).to.not.equal(null);
  });
}
