meta {
  name: filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/items?status=in-storage&terminal_id=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A3.2: ?status, ?category and ?terminal_id filters return the correct subsets (status + terminal)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(17);
    res.body.data.forEach(item => {
      expect(item.status).to.equal("in-storage");
      expect(item.terminal.id).to.equal(2);
    });
  });
}
