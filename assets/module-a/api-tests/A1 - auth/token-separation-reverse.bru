meta {
  name: token-separation-reverse
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/passenger/claims
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A1.6: Staff and passenger tokens are separate systems — each is rejected on the other's endpoints (401 both directions; documented exception: GET /terminals) (staff token on passenger endpoint)", function() {
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Unauthenticated");
  });
}
