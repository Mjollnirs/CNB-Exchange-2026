meta {
  name: staff-token-invalidated
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A1.4: POST /logout invalidates the token and returns 200 — subsequent requests with the old token get 401 (old token rejected)", function() {
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Unauthenticated");
  });
}
