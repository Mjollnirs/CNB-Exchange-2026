meta {
  name: confirm-match
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/claims/1/match
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "item_id": {{matchItemId}} }
}

tests {
  test("A6.6: POST /claims/{id}/match links claim and item (both matched); requires claim under-review and item in-storage (422 otherwise) (links claim and item)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("matched");
    expect(res.body.data.matched_item.id).to.equal(parseInt(bru.getEnvVar("matchItemId")));
    expect(res.body.data.matched_item).to.have.property("storage_shelf");
  });
}
