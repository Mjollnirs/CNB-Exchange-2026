meta {
  name: filter-category
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/items?category=jewellery&status=in-storage
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A3.2: ?status, ?category and ?terminal_id filters return the correct subsets (category)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(5);
    res.body.data.forEach(item => expect(item.category).to.equal("jewellery"));
  });
}
