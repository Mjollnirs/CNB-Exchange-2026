meta {
  name: claim-not-owned
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/passenger/claims/18
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A8.5: GET /passenger/claims/{id} returns 404 when the claim is not owned by the authenticated passenger (404 when not owned)", function() {
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("Resource not found");
  });
}
